# Local: omit DATABASE_URL to use data/health.sqlite (Node 24+).
# Production: PostgreSQL is required; use your provider's SSL connection string.
DATABASE_URL=
# Alternative name supplied by some Vercel integrations. DATABASE_URL takes precedence.
POSTGRES_URL=
APP_URL=http://localhost:3000
# Used only by the CLI bootstrap; web registration never grants admin privileges.
ADMIN_EMAIL=
# Only set this when running admin:create. Never use a real password in this example.
ADMIN_PASSWORD=
ADMIN_USERNAME=Boza
# Configure real identity/contact information before accepting third-party users.
PRIVACY_CONTACT=
DATA_CONTROLLER=
# Recovery emails; without SMTP recovery is unavailable (tokens are never logged).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
